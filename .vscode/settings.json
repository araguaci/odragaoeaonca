  "editor.tokenColorCustomizations": {
      "comments": "#8a99a8",
      "strings": "#3ecb6f",
      "keywords": "#ff6b5f",
      "numbers": "#e8b23d",
      "types": "#2ecfb0",
      "functions": "#ffd270",
      "variables": "#e8edf0",
      "textMateRules": [
          {
              "scope": ["keyword.control", "keyword.operator.new", "storage.type", "storage.modifier"],
              "settings": { "foreground": "#ff6b5f" }
          },
          {
              "scope": ["entity.name.function", "support.function"],
              "settings": { "foreground": "#ffd270" }
          },
          {
              "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
              "settings": { "foreground": "#2ecfb0" }
          },
          {
              "scope": ["variable.parameter", "variable.other"],
              "settings": { "foreground": "#e8edf0" }
          },
          {
              "scope": ["constant.language", "constant.numeric", "constant.other"],
              "settings": { "foreground": "#e8b23d" }
          },
          {
              "scope": ["string", "string.quoted"],
              "settings": { "foreground": "#3ecb6f" }
          },
          {
              "scope": ["comment", "punctuation.definition.comment"],
              "settings": { "foreground": "#8a99a8", "fontStyle": "italic" }
          },
          {
              "scope": ["entity.name.tag", "punctuation.definition.tag"],
              "settings": { "foreground": "#d4342c" }
          },
          {
              "scope": ["entity.other.attribute-name"],
              "settings": { "foreground": "#b07aff" }
          },
          {
              "scope": ["markup.heading"],
              "settings": { "foreground": "#ffd270", "fontStyle": "bold" }
          },
          {
              "scope": ["markup.bold"],
              "settings": { "foreground": "#e8b23d", "fontStyle": "bold" }
          },
          {
              "scope": ["markup.italic"],
              "settings": { "foreground": "#ff6b5f", "fontStyle": "italic" }
          },
          {
              "scope": ["markup.inline.raw", "markup.fenced_code"],
              "settings": { "foreground": "#2ecfb0" }
          },
          {
              "scope": ["markup.underline.link"],
              "settings": { "foreground": "#b07aff" }
          }
      ]
  },
