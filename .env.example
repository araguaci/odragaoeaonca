# X API — gap analysis (scripts/fetch_x_articles.py)
# Copie: cp .env.example .env
# Guia completo: scripts/README-x-articles.md  (seção "Como obter os tokens")
# Nunca commitar .env

# ── Preferido (owned reads da sua conta) ───────────────────────────
# Access Token do usuário @araguaci (Keys and tokens → Access Token)
# ou Access Token OAuth 2.0 User Context (PKCE), se usar esse fluxo.
X_ACCESS_TOKEN=

# ── App-only (timeline pública) ────────────────────────────────────
# Bearer Token do App (Keys and tokens → Bearer Token).
# X_API_BEARER_TOKEN e X_BEARER_TOKEN são aliases — preencha só um.
X_API_BEARER_TOKEN=
# X_BEARER_TOKEN=

# Prioridade no script: X_ACCESS_TOKEN > X_API_BEARER_TOKEN > X_BEARER_TOKEN
